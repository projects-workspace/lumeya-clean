{
  "name": "santiago-way",
  "version": "0.0.0",
  "private": true,
  "description": "Santiago Way — developer verification tooling only. The production frontend remains static HTML/CSS/JS with no build step.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "verify": "npm run catalog:check && npm run verify:editorial && node verify/run.js",
    "catalog:validate": "node scripts/catalog.js validate",
    "catalog:publish": "node scripts/catalog.js publish",
    "catalog:check": "node scripts/catalog.js check",
    "verify:pages": "node verify/run.js --pages",
    "verify:links": "node verify/run.js --links",
    "verify:assets": "node verify/run.js --assets",
    "verify:js": "node verify/run.js --js",
    "verify:static": "node verify/run.js --static",
    "verify:mvp": "node verify/run.js --mvp",
    "verify:journey": "node verify/run.js --journey",
    "verify:security": "node verify/run.js --security",
    "verify:secrets": "node verify/run.js --secrets",
    "verify:smoke": "node verify/run.js --smoke",
    "verify:static-only": "npm run catalog:check && node verify/run.js --pages --links --assets --js --static --mvp --journey --security --secrets",
    "editorial": "node scripts/editorial.js",
    "dev:editorial": "node scripts/editorial-preview.js",
    "verify:editorial": "node --test verify/editorial.test.js verify/events.test.js"
  },
  "devDependencies": {
    "supabase": "2.116.0"
  }
}
